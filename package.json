{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-copy-response",
  "version": "1.0.0",
  "description": "copy the latest assistant response, or the whole session transcript, from the opencode terminal",
  "type": "module",
  "license": "MIT",
  "author": "notsegun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/notsegun/opencode-copy-response.git"
  },
  "homepage": "https://github.com/notsegun/opencode-copy-response#readme",
  "bugs": {
    "url": "https://github.com/notsegun/opencode-copy-response/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "clipboard",
    "copy",
    "markdown",
    "tui"
  ],
  "exports": {
    "./tui": {
      "import": "./tui.tsx",
      "types": "./tui.tsx"
    }
  },
  "files": [
    "tui.tsx",
    "response.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.17",
    "@opentui/solid": ">=0.5.17",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "2.0.27",
    "@opencode/plugin": "2.0.27",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
